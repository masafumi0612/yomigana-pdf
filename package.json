{
  "name": "yomigana-pdf",
  "version": "0.0.0",
  "private": true,
  "description": "PDF の漢字によみがな（ルビ）を自動で付ける Chrome 拡張機能",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "prepare": "simple-git-hooks",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "licenses:check": "node scripts/check-licenses.ts",
    "test-pdfs:make": "node scripts/test-pdfs/make.ts",
    "test-pdfs:check": "node scripts/test-pdfs/check.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "79.0.0",
    "fontkit": "2.0.4",
    "globals": "17.14.0",
    "lint-staged": "17.6.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  },
  "allowScripts": {
    "simple-git-hooks": false
  }
}
